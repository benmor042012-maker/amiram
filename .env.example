# Copy to .dev.vars for `wrangler dev`. Production: `wrangler secret put <NAME>`.
# Never commit real values.

# --- AI (Claude) ---
ANTHROPIC_API_KEY=

# --- Owner notifications ---
# "console" (logs only, for local dev) or "twilio"
NOTIFICATION_PROVIDER=console
OWNER_PHONE=+1XXXXXXXXXX
OWNER_EMAIL=

# --- Customer SMS (website leads, replies): "console" or "twilio" ---
CUSTOMER_SMS_PROVIDER=console

# --- Twilio (required when either provider is "twilio"; the auth token also
# verifies inbound SMS webhooks) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# --- Inbound webhook shared secrets (sent by Zapier / the website form) ---
YELP_WEBHOOK_SECRET=change-me
WEBSITE_WEBHOOK_SECRET=change-me

# --- Admin API (Bearer token) ---
ADMIN_TOKEN=change-me
